+  - {route_id: RSL-R07, artifact: test-spec, contract: UAC, checker: [TSV-CONTRACT, TSV-EXIT]}
+  - {route_id: RSL-R08, artifact: integration-upgrade, contract: UAC, checker: [TSV-CONTRACT, TSV-REG, TSV-REGRESSION]}
+  - {route_id: RSL-R09, artifact: adapter-doc, contract: UAC, checker: [TSV-CONTRACT, TSV-RUNTIME]}
+
+responsibility:
+  rows:
+    - {name: 停止／禁止閘門, owner: GOV}
+    - {name: 任務分類與四態, owner: GOV}
