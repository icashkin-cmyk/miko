+
+ucp:
+  steps: [A00, A01, A02, A03, A04, A05, A06, A07, A08, A09, A10, A11, A12, A13]
+  required_fields:
+    - 目的
+    - 輸入
+    - 輸出
+    - 前置條件
+    - 操作要求
+    - 禁止事項
+    - 檢查點
