#!/usr/bin/env bash
# miko repo pre-push 檢查（提案，未進正本）。找不到 check_repo、MIKO_PRIVATE_WORDS 為空、結束碼非 0、輸出有 FAIL／NOT_RUN 行或缺「合計」行都擋（ADR-065）。
# 不做不可逆操作：不自動修、不 stash、不改遠端。緊急略過要在回報寫明並附理由。
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
fail() { printf '[pre-push] 擋下：%s\n[pre-push] 修正建議：%s\n[pre-push] 重新執行：%s\n' "$1" "$2" "$3" >&2; exit 1; }

[ -f tests/check_repo.py ] || fail '找不到 tests/check_repo.py，無法驗證' '確認在 miko repo 根目錄、分支未刪檢查程式' 'git push'
[ -n "${MIKO_PRIVATE_WORDS:-}" ] || fail 'MIKO_PRIVATE_WORDS 沒帶，C3／C12 不會掃私密字' '照專案指示把私密字清單帶進環境變數（不寫進任何檔案）' 'MIKO_PRIVATE_WORDS="<照專案指示>" git push'

# 底本：遠端已有的 commit（git 由 stdin 給「本地ref 本地sha 遠端ref 遠端sha」），讓 C11 比的是遠端版而不是 HEAD
ZERO=0000000000000000000000000000000000000000
BASE=""
while read -r _lr _ls _rr rs; do
  if [ -n "${rs:-}" ] && [ "$rs" != "$ZERO" ] && git cat-file -e "$rs^{commit}" 2>/dev/null; then BASE=$rs; fi
done
[ -n "$BASE" ] || BASE=$(git rev-parse -q --verify HEAD~1 || true)

printf '[pre-push] 執行 check_repo（MIKO_BASE=%s）\n' "${BASE:0:7}"
OUT=$(MIKO_BASE="$BASE" python3 -I -B tests/check_repo.py 2>&1); RC=$?
printf '%s\n' "$OUT"
[ $RC -eq 0 ] || fail "check_repo 結束碼 $RC" '看上方 FAIL 行逐項修' 'python3 -I -B tests/check_repo.py'
printf '%s\n' "$OUT" | grep -qE '^(FAIL|NOT_RUN) ' && fail '輸出有 FAIL 或 NOT_RUN 行（結束碼 0 不能單獨算通過）' '看上方 FAIL／NOT_RUN 行；推送要全部 PASS' 'python3 -I -B tests/check_repo.py'
printf '%s\n' "$OUT" | grep -qE '^合計：[0-9]+/[0-9]+ PASS' || fail '輸出缺「合計」行，無法確認檢查跑完' '直接執行 check_repo 看是否中途當掉' 'python3 -I -B tests/check_repo.py'
printf '[pre-push] 通過\n'
